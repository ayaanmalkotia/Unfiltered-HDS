{
  "manifest_version": 3,
  "name": "Unfiltered",
  "version": "1.0.0",
  "description": "An AI that catches you rationalizing your behavior.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unfiltered"
  }
}